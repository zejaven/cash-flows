<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-07-21-14-00-05_create_fx_rate_snapshot" author="zejaven">
        <createTable tableName="fx_rate_snapshot" schemaName="cashflow">
            <column name="id" type="bigint" autoIncrement="true" generationType="BY DEFAULT">
                <constraints primaryKey="true" primaryKeyName="pk_fx_rate_snapshot" nullable="false"/>
            </column>
            <column name="snapshot_date" type="date">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_fx_rate_snapshot_date"/>
            </column>
            <column name="base_currency" type="varchar(8)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="rates" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="fetched_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="fx_rate_snapshot" schemaName="cashflow"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
