<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-07-21-16-00-03_create_statement_account_skip" author="zejaven">
        <createTable tableName="statement_account_skip" schemaName="cashflow">
            <column name="id" type="bigint" autoIncrement="true" generationType="BY DEFAULT">
                <constraints primaryKey="true" primaryKeyName="pk_statement_account_skip" nullable="false"/>
            </column>
            <column name="bank_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_statement_account_skip_bank"
                             referencedTableSchemaName="cashflow"
                             referencedTableName="bank" referencedColumnNames="id"/>
            </column>
            <column name="account_number" type="varchar(34)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="statement_account_skip" schemaName="cashflow"
                             columnNames="bank_id, account_number"
                             constraintName="uq_statement_account_skip"/>
        <rollback>
            <dropTable tableName="statement_account_skip" schemaName="cashflow"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
