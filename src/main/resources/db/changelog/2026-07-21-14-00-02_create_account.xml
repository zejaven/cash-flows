<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-07-21-14-00-02_create_account" author="zejaven">
        <createTable tableName="account" schemaName="cashflow">
            <column name="id" type="bigint" autoIncrement="true" generationType="BY DEFAULT">
                <constraints primaryKey="true" primaryKeyName="pk_account" nullable="false"/>
            </column>
            <column name="name" type="varchar(128)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_account_name"/>
            </column>
            <column name="currency" type="varchar(8)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="bank_id" type="bigint">
                <constraints foreignKeyName="fk_account_bank" referencedTableSchemaName="cashflow"
                             referencedTableName="bank" referencedColumnNames="id"/>
            </column>
            <column name="account_number" type="varchar(64)"/>
            <column name="start_balance" type="numeric(19,4)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="archived" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>ALTER TABLE cashflow.account ADD CONSTRAINT chk_account_type
            CHECK (type IN ('BANK', 'CASH', 'CRYPTO'))</sql>
        <sql>ALTER TABLE cashflow.account ADD CONSTRAINT chk_account_currency_upper
            CHECK (currency = upper(currency))</sql>
        <createIndex tableName="account" schemaName="cashflow" indexName="idx_account_bank_id">
            <column name="bank_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="account" schemaName="cashflow"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
