<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-07-21-16-00-02_create_category_rule" author="zejaven">
        <createTable tableName="category_rule" schemaName="cashflow">
            <column name="id" type="bigint" autoIncrement="true" generationType="BY DEFAULT">
                <constraints primaryKey="true" primaryKeyName="pk_category_rule" nullable="false"/>
            </column>
            <column name="pattern" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_category_rule_category"
                             referencedTableSchemaName="cashflow"
                             referencedTableName="category" referencedColumnNames="id"/>
            </column>
            <column name="archived" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="category_rule" schemaName="cashflow"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
